{
  "schema_version": "givecare.module/v2",
  "repository": "care-evals",
  "owns": "Public caregiver eval records, instrument distribution, and dependency-free validators",
  "check": "scripts/check.sh",
  "produces": [
    {"id": "gc-evals.gold-case/v1", "path": "data/all.jsonl", "for": ["invisiblebench", "invisiblebench-private"]}
  ],
  "consumes": [
    {"id": "@givecare/tools.InstrumentExport", "from": "assessment"},
    {"id": "givecare.protocol", "from": "."}
  ]
}
